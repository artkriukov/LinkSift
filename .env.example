# Copy to .env. Never commit real credentials.
LINKSIFT_ENVIRONMENT=local
LINKSIFT_BOT_TOKEN=
LINKSIFT_DATABASE_URL=
LINKSIFT_TEST_DATABASE_URL=
LINKSIFT_DATA_DIR=./data
LINKSIFT_MAX_DURATION_SECONDS=1800
LINKSIFT_MAX_FILE_SIZE_MB=20
LINKSIFT_MEDIA_TTL_SECONDS=3600
LINKSIFT_HISTORY_TTL_DAYS=30
# Architecture choice only: provider adapters are not implemented yet.
LINKSIFT_ANALYSIS_PIPELINE=gemini
LINKSIFT_GEMINI_API_KEY=
LINKSIFT_GEMINI_MODEL=
